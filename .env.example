# FlowForge environment configuration
# Copy this file to .env and fill in your values.
# URLs below target local dev (docker compose publishes Postgres/Redis on localhost).
# docker compose overrides them with in-network hosts for the api/worker containers.

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flowforge

# Redis connection string
REDIS_URL=redis://localhost:6379

# Base URL for the API (used for webhook callbacks)
BASE_URL=http://localhost:4000

# API key for authenticating requests to the API.
# Leave empty to disable auth (not recommended for production).
# Generate with: openssl rand -hex 32
API_KEY=

# 32-byte hex key for encrypting credentials.
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# Worker concurrency (number of parallel flow executions)
EXECUTOR_CONCURRENCY=5
