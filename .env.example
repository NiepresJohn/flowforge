# Core
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flowforge

# Redis (BullMQ queues + presence)
REDIS_URL=redis://localhost:6379

# Execution
EXECUTOR_CONCURRENCY=5

# API → Worker
QUEUE_NAME=flow-executions

# Webhooks
BASE_URL=http://localhost:4000

# Encryption for stored credentials (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CREDENTIAL_ENCRYPTION_KEY=changeme-32-bytes-of-entropy-please
