{
	"name": "flowforge",
	"version": "0.1.0",
	"description": "Self-hosted workflow automation platform (mini-Zapier). Visual flow builder, pluggable integrations, durable execution.",
	"private": true,
	"engines": {
		"node": ">=22",
		"pnpm": ">=9"
	},
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "pnpm -r --parallel --filter './apps/*' run dev",
		"build": "pnpm -r --if-present build",
		"lint": "pnpm -r --if-present lint && biome check .",
		"typecheck": "pnpm -r --if-present typecheck",
		"test": "pnpm -r --if-present test",
		"test:coverage": "pnpm -r --if-present test:coverage",
		"test:e2e": "playwright test --config e2e/playwright.config.ts",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.0",
		"@playwright/test": "^1.61.1",
		"@tsconfig/strictest": "^2.0.5",
		"@types/node": "^26.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.4.3",
		"typescript": "~5.7.0",
		"tsx": "^4.20.0",
		"vitest": "^3.2.0"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx}": ["biome check --write --no-errors-on-unmatched"],
		"*.{json,md}": ["biome format --write --no-errors-on-unmatched"]
	}
}
